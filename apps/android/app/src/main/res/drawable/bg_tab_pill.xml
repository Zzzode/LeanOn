<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid-glass pill behind the selected tab.
     Bright opaque white with a subtle vertical gradient for depth,
     matching iOS 26. Corner radius is animated in code
     (GradientDrawable.setCornerRadius) to stay proportional to the height. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#FFFFFFFF"
        android:endColor="#F0FFFFFF"
        android:angle="270" />
    <corners android:radius="27dp" />
    <stroke
        android:width="1dp"
        android:color="#FFFFFFFF" />
</shape>
