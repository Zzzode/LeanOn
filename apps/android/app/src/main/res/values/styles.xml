<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tab bar text appearances: compact, matching iOS 26 proportions. -->
    <style name="TextAppearance.LeanOn.TabLabel.Active" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.LeanOn.TabLabel.Inactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Active indicator: compact pill, matching iOS glass highlight. -->
    <style name="Widget.LeanOn.TabIndicator.Active" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">44dp</item>
        <item name="android:height">28dp</item>
        <item name="marginHorizontal">4dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LeanOn.TabIndicator</item>
    </style>

    <style name="ShapeAppearance.LeanOn.TabIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
</resources>
