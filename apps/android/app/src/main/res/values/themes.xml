<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LeanOn" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/botanical</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorSurfaceContainer">@color/white</item>
    </style>

    <!-- Theme overlay for the floating tab bar: sets the XML-only
         itemActiveIndicatorStyle so the active pill matches iOS proportions. -->
    <style name="Theme.LeanOn.TabBar" parent="Theme.LeanOn">
        <item name="itemActiveIndicatorStyle">@style/Widget.LeanOn.TabIndicator.Active</item>
    </style>
</resources>
