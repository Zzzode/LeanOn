<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Camera used by the barcode scanner (RFC 0016). -->
  <uses-permission android:name="android.permission.CAMERA" />

  <!-- Legacy Bluetooth (API 30 and below). -->
  <uses-permission
    android:name="android.permission.BLUETOOTH"
    android:maxSdkVersion="30" />
  <uses-permission
    android:name="android.permission.BLUETOOTH_ADMIN"
    android:maxSdkVersion="30" />
  <!-- Android 12+ split Bluetooth permissions. Scanning never derives location. -->
  <uses-permission
    android:name="android.permission.BLUETOOTH_SCAN"
    android:usesPermissionFlags="neverForLocation" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
  <!-- Location is required to receive scan results on API 26-30. -->
  <uses-permission
    android:name="android.permission.ACCESS_FINE_LOCATION"
    android:maxSdkVersion="30" />

  <uses-feature
    android:name="android.hardware.bluetooth_le"
    android:required="false" />
  <uses-feature
    android:name="android.hardware.camera"
    android:required="false" />

  <application
    android:name=".LeanOnApplication"
    android:allowBackup="false"
    android:label="LeanOn"
    android:supportsRtl="true"
    android:theme="@style/Theme.AppCompat.Light.NoActionBar">

    <activity
      android:name=".MainActivity"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <activity
      android:name=".scanner.BarcodeScanActivity"
      android:exported="false"
      android:theme="@style/Theme.AppCompat.NoActionBar" />
  </application>
</manifest>
