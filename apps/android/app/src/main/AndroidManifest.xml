<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Camera used by the barcode scanner (RFC 0016). -->
  <uses-permission android:name="android.permission.CAMERA" />
  <!-- Daily local reminders on Android 13+ (RFC 0020). -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- One-way export to Health Connect (RFC 0021). -->
  <uses-permission android:name="android.permission.health.READ_WEIGHT" />
  <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />
  <uses-permission android:name="android.permission.health.WRITE_NUTRITION" />
  <uses-permission android:name="android.permission.health.READ_EXERCISE" />
  <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />

  <!-- Legacy Bluetooth (API 30 and below). -->
  <uses-permission
    android:name="android.permission.BLUETOOTH"
    android:maxSdkVersion="30" />
  <uses-permission
    android:name="android.permission.BLUETOOTH_ADMIN"
    android:maxSdkVersion="30" />
  <!-- Android 12+ split Bluetooth permissions. Scanning never derives location. -->
  <uses-permission
    android:name="android.permission.BLUETOOTH_SCAN"
    android:usesPermissionFlags="neverForLocation" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
  <!-- Location is required to receive scan results on API 26-30. -->
  <uses-permission
    android:name="android.permission.ACCESS_FINE_LOCATION"
    android:maxSdkVersion="30" />

  <uses-feature
    android:name="android.hardware.bluetooth_le"
    android:required="false" />
  <uses-feature
    android:name="android.hardware.camera"
    android:required="false" />

  <!-- Locate the Health Connect app/package for availability and permission flows. -->
  <queries>
    <package android:name="com.google.android.apps.healthdata" />
  </queries>

  <application
    android:name=".LeanOnApplication"
    android:allowBackup="false"
    android:icon="@mipmap/ic_launcher"
    android:label="LeanOn"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:supportsRtl="true"
    android:theme="@style/Theme.AppCompat.Light.NoActionBar">

    <activity
      android:name=".MainActivity"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <activity
      android:name=".scanner.BarcodeScanActivity"
      android:exported="false"
      android:theme="@style/Theme.AppCompat.NoActionBar" />

    <!-- Health Connect permission rationale (pre-Android 14) and usage link (14+). -->
    <activity
      android:name=".healthconnect.HealthConnectRationaleActivity"
      android:exported="true">
      <intent-filter>
        <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
      </intent-filter>
    </activity>
    <activity-alias
      android:name="ViewPermissionUsageActivity"
      android:exported="true"
      android:targetActivity=".healthconnect.HealthConnectRationaleActivity"
      android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
      <intent-filter>
        <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
        <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
      </intent-filter>
    </activity-alias>
  </application>
</manifest>
